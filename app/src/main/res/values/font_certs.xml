<?xml version="1.0" encoding="utf-8"?>
<!--
    Certificate set for Google Fonts provider (com.google.android.gms.fonts).
    These are the standard SHA-256 fingerprints shipped with Google Play Services.
    Required by the Compose ui-text-google-fonts downloadable font API.
-->
<resources>
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>

    <!-- Development certificate -->
    <string-array name="com_google_android_gms_fonts_certs_dev">
        <item>
            
        </item>
    </string-array>

    <!-- Production certificate -->
    <string-array name="com_google_android_gms_fonts_certs_prod">
        <item>
            
        </item>
    </string-array>
</resources>
